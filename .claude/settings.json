{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(dotnet clean:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tail:*)",
      "Bash(seq:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(rm src/*)",
      "Bash(rm tests/*)",
      "Bash(git rm:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(taskkill //F //IM:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null -w:*)",
      "Bash(curl -s -i http://localhost:*)",
      "Bash(curl -i http://localhost:*)",
      "Bash(curl -s -w:*)",
      "Bash(curl -s -L http://localhost:*)",
      "Bash(printf:*)",
      "Bash(dotnet publish:*)",
      "Bash(dotnet watch:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(sleep:*)",
      "Bash(pkill:*)",
      "Bash(taskkill:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-tests.sh\""
          }
        ]
      }
    ]
  }
}
