@page
@using System.Globalization
@using Chronos.Web.Domain
@model IndexModel
@{
    ViewData["Title"] = "Week";
    var inv = CultureInfo.InvariantCulture;
}

<form method="get" action="/" class="week-picker">
    <label for="week">Week starting</label>
    <select id="week" name="week">
        @foreach (var w in Model.AvailableWeeks)
        {
            <option value="@w" selected="@(w == Model.SelectedWeek && !Model.WeekNotFound)">@w</option>
        }
    </select>
    <button type="submit">Show week</button>
</form>

@if (Model.WeekNotFound || Model.Week is null || Model.Kpis is null)
{
    <section class="notice" aria-labelledby="nf-h">
        <h1 id="nf-h">Week not found</h1>
        <p>Choose one of the weeks in the selector above.</p>
    </section>
}
else
{
    var week = Model.Week;
    var kpis = Model.Kpis;
    <header class="week-head">
        <h1>@week.Employee.Name</h1>
        <p class="meta">
            <span>Team: @week.Employee.Team</span>
            <span>Week: @week.Week.Start to @week.Week.End</span>
        </p>
    </header>

    <div class="layout">
        <div class="main-col">
            <section id="violations" class="panel" hidden aria-label="Violations"></section>

            @{ var rowNo = 0; }
            @foreach (var day in Model.Days)
            {
                <section class="day" aria-labelledby="day-@day.Key.ToString("yyyy-MM-dd")">
                    <div class="day-head">
                        <h2 id="day-@day.Key.ToString("yyyy-MM-dd")">@day.Key.ToString("yyyy-MM-dd") <span class="dow">@day.Key.ToString("dddd", inv)</span></h2>
                        <p class="day-total">Worked <strong>@IndexModel.Hmm(kpis.WorkedByDay.GetValueOrDefault(day.Key))</strong></p>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Start</th>
                                    <th scope="col">End</th>
                                    <th scope="col">Duration</th>
                                    <th scope="col">Source</th>
                                    <th scope="col">Category</th>
                                    @if (Model.CanEdit)
                                    {
                                        <th scope="col">Change</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in day)
                                {
                                    var n = ++rowNo;
                                    var form = IndexModel.EditForm(e.Key);
                                    var eStart = Model.Error(form, "Start");
                                    var eEnd = Model.Error(form, "End");
                                    var eCat = Model.Error(form, "Category");
                                    <tr class="entry" data-key="@e.Key">
                                        <td>@e.Start.ToString("HH:mm", inv)</td>
                                        <td>@e.End.ToString("HH:mm", inv)</td>
                                        <td>@IndexModel.Hmm(e.Minutes)</td>
                                        <td>
                                            @if (e.SourceKind == SourceKind.Absence)
                                            {
                                                <span class="src-title">@e.SourceTitle</span>
                                            }
                                            else
                                            {
                                                <span class="src-id">@e.SourceId</span> <span class="src-title">@e.SourceTitle</span>
                                            }
                                        </td>
                                        <td>
                                            @if (e.Category is null)
                                            {
                                                <span class="cat cat-none">none</span>
                                            }
                                            else
                                            {
                                                <span class="cat cat-@e.Category.ToLowerInvariant()">@e.Category</span>
                                            }
                                        </td>
                                        @if (Model.CanEdit)
                                        {
                                            <td>
                                                <details class="edit" open="@Model.HasErrors(form)">
                                                    <summary>Edit</summary>
                                                    <form method="post" asp-page-handler="Edit" class="edit-form">
                                                        <input type="hidden" name="week" value="@Model.SelectedWeek" />
                                                        <input type="hidden" name="key" value="@e.Key" />
                                                        <div class="field">
                                                            <label for="es-@n">Start</label>
                                                            <input id="es-@n" name="start" type="time" required value="@Model.Value(form, "Start", e.Start.ToString("HH:mm", inv))" aria-invalid="@(eStart is not null ? "true" : null)" aria-describedby="@(eStart is not null ? $"es-err-{n}" : null)" />
                                                            @if (eStart is not null) { <span class="field-error" id="es-err-@n">@eStart</span> }
                                                        </div>
                                                        <div class="field">
                                                            <label for="ee-@n">End</label>
                                                            <input id="ee-@n" name="end" type="time" required value="@Model.Value(form, "End", e.End.ToString("HH:mm", inv))" aria-invalid="@(eEnd is not null ? "true" : null)" aria-describedby="@(eEnd is not null ? $"ee-err-{n}" : null)" />
                                                            @if (eEnd is not null) { <span class="field-error" id="ee-err-@n">@eEnd</span> }
                                                        </div>
                                                        <div class="field">
                                                            <label for="ec-@n">Category</label>
                                                            <input id="ec-@n" name="category" type="text" list="categories" autocomplete="off" value="@Model.Value(form, "Category", e.Category ?? "")" aria-invalid="@(eCat is not null ? "true" : null)" aria-describedby="@(eCat is not null ? $"ec-err-{n}" : null)" />
                                                            @if (eCat is not null) { <span class="field-error" id="ec-err-@n">@eCat</span> }
                                                        </div>
                                                        <button type="submit" class="btn">Save</button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Delete" class="delete-form">
                                                        <input type="hidden" name="week" value="@Model.SelectedWeek" />
                                                        <input type="hidden" name="key" value="@e.Key" />
                                                        <button type="submit" class="btn btn-danger">Delete</button>
                                                    </form>
                                                </details>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            @if (Model.CanEdit)
            {
                var aDate = Model.Error(IndexModel.AddForm, "Date");
                var aStart = Model.Error(IndexModel.AddForm, "Start");
                var aEnd = Model.Error(IndexModel.AddForm, "End");
                var aCat = Model.Error(IndexModel.AddForm, "Category");
                <section class="panel" aria-labelledby="add-h">
                    <h2 id="add-h">Add entry</h2>
                    <form method="post" asp-page-handler="Add" class="edit-form add-form">
                        <input type="hidden" name="week" value="@Model.SelectedWeek" />
                        <div class="field">
                            <label for="a-date">Date</label>
                            <input id="a-date" name="date" type="date" required value="@Model.Value(IndexModel.AddForm, "Date", week.Week.Start)" aria-invalid="@(aDate is not null ? "true" : null)" aria-describedby="@(aDate is not null ? "a-date-err" : null)" />
                            @if (aDate is not null) { <span class="field-error" id="a-date-err">@aDate</span> }
                        </div>
                        <div class="field">
                            <label for="a-start">Start</label>
                            <input id="a-start" name="start" type="time" required value="@Model.Value(IndexModel.AddForm, "Start", "")" aria-invalid="@(aStart is not null ? "true" : null)" aria-describedby="@(aStart is not null ? "a-start-err" : null)" />
                            @if (aStart is not null) { <span class="field-error" id="a-start-err">@aStart</span> }
                        </div>
                        <div class="field">
                            <label for="a-end">End</label>
                            <input id="a-end" name="end" type="time" required value="@Model.Value(IndexModel.AddForm, "End", "")" aria-invalid="@(aEnd is not null ? "true" : null)" aria-describedby="@(aEnd is not null ? "a-end-err" : null)" />
                            @if (aEnd is not null) { <span class="field-error" id="a-end-err">@aEnd</span> }
                        </div>
                        <div class="field">
                            <label for="a-cat">Category</label>
                            <input id="a-cat" name="category" type="text" list="categories" autocomplete="off" value="@Model.Value(IndexModel.AddForm, "Category", "")" aria-invalid="@(aCat is not null ? "true" : null)" aria-describedby="@(aCat is not null ? "a-cat-err" : null)" />
                            @if (aCat is not null) { <span class="field-error" id="a-cat-err">@aCat</span> }
                        </div>
                        <button type="submit" class="btn">Add entry</button>
                    </form>
                    <datalist id="categories">
                        @foreach (var c in EntryInputValidator.ValidCategories)
                        {
                            <option value="@c"></option>
                        }
                    </datalist>
                    <form method="post" asp-page-handler="Reset" class="reset-form">
                        <input type="hidden" name="week" value="@Model.SelectedWeek" />
                        <button type="submit" class="btn btn-quiet">Reset to proposal</button>
                    </form>
                </section>
            }
        </div>

        <aside class="side-col">
            <section class="panel kpi" aria-labelledby="kpi-h">
                <h2 id="kpi-h">KPIs</h2>
                <p class="big">Worked / target <strong>@IndexModel.Hmm(kpis.WorkedMinutes) / @IndexModel.Hmm(kpis.TargetMinutes)</strong></p>
                <dl class="stats">
                    <div><dt>Project share</dt><dd>@kpis.ProjectSharePercent%</dd></div>
                    <div><dt>Meeting time</dt><dd>@IndexModel.Hmm(kpis.MeetingMinutes)</dd></div>
                </dl>
                <h3>Time per category</h3>
                <dl class="stats">
                    @foreach (var c in KpiCalculator.CategoryOrder)
                    {
                        <div><dt>@c</dt><dd>@IndexModel.Hmm(kpis.MinutesByCategory.GetValueOrDefault(c))</dd></div>
                    }
                </dl>
            </section>

            <section class="panel" aria-labelledby="wi-h">
                <h2 id="wi-h">Work items</h2>
                @if (Model.WorkItems.Count == 0)
                {
                    <p class="empty">No work item has time this week.</p>
                }
                else
                {
                    <ul class="plain">
                        @foreach (var wi in Model.WorkItems)
                        {
                            <li class="wi">
                                <p><span class="src-id">@wi.Id</span> <span>@wi.Title</span></p>
                                <p class="sub">Type: @wi.Type, PROJ time: <strong>@IndexModel.Hmm(wi.ProjMinutes)</strong></p>
                                @if (wi.PullRequests.Count > 0)
                                {
                                    <ul class="plain prs">
                                        @foreach (var pr in wi.PullRequests)
                                        {
                                            <li>PR <span class="src-id">@pr.Id</span> <span>@pr.Title</span> <span class="state state-@pr.State">@pr.State</span></li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="panel" aria-labelledby="ign-h">
                <h2 id="ign-h">Ignored activity</h2>
                @if (Model.Proposal.IgnoredCommits.Count == 0)
                {
                    <p class="empty">No commits were ignored.</p>
                }
                else
                {
                    <ul class="plain">
                        @foreach (var c in Model.Proposal.IgnoredCommits)
                        {
                            <li class="ignored">
                                <p><span class="src-id">@c.Sha</span> <span class="sub">@c.Date</span></p>
                                <p>@c.Message</p>
                                <p class="sub">Reason: <strong>@c.Reason</strong></p>
                            </li>
                        }
                    </ul>
                }
            </section>
        </aside>
    </div>
}
